<div class="layout layout--col gap--small">
  <div class="flex flex--row flex--between w--full">
    <span class="title title--small" data-clamp="1">{{ card_title }}</span>
    <span class="label label--inverted">{{ ems }}</span>
  </div>
  <div class="columns" data-overflow-max-cols="1">
    <div class="column">
      {%- for s in card.s limit: 3 %}
      <div class="item">
        <div class="meta"><span class="index">{{ forloop.index }}</span></div>
        <div class="content">
          <span class="description description--small" data-clamp="1">{{ s | replace: tok_ems, ems | replace: tok_poison, poison }}</span>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHJlY3QgeD0iMSIgeT0iMSIgd2lkdGg9IjIyIiBoZWlnaHQ9IjIyIiByeD0iNCIgZmlsbD0iIzAwMCIvPjxwYXRoIGQ9Ik0xMCA1aDR2NWg1djRoLTV2NWgtNHYtNUg1di00aDV6IiBmaWxsPSIjZmZmIi8+PC9zdmc+">
  <span class="title">{{ ui.app }}</span>
  <span class="instance">{{ ui.disclaimer }}</span>
</div>
