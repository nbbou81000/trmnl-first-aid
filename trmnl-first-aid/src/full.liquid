<div class="layout">
  <div class="grid w--full h--full">
    {%- if has_img %}
    <div class="col--span-5 flex flex--center h--full">
      <img class="image image-dither image--contain w--full h--full" src="{{ img_url }}">
    </div>
    {%- else %}
    <div class="col--span-4 flex flex--center h--full">
      <div class="outline flex flex--col flex--center gap w--full h--full">
        <span class="label">{{ ui.call }}</span>
        <span class="value value--giga" data-fit-value="true">{{ ems }}</span>
      </div>
    </div>
    {%- endif %}
    <div class="{% if has_img %}col--span-7{% else %}col--span-8{% endif %} flex flex--col flex--left gap--medium">
      <span class="title title--large" data-clamp="2">{{ card_title }}</span>
      <span class="label label--large label--gray" data-clamp="2">{{ card_when }}</span>
      <div class="columns" data-overflow-max-cols="1">
        <div class="column">
          {%- for s in card.s %}
          <div class="item">
            <div class="meta"><span class="index">{{ forloop.index }}</span></div>
            <div class="content">
              <span class="description description--large">{{ s | replace: "{EMS}", ems | replace: "{POISON}", poison }}</span>
            </div>
          </div>
          {%- endfor %}
        </div>
      </div>
      <span class="label label--small label--gray" data-clamp="1">{{ credit_line }}</span>
    </div>
  </div>
</div>

